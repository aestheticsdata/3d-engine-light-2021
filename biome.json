{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "plugins": [
    "./biome-plugins/d04-no-abstract.grit",
    "./biome-plugins/d04-no-inheritance.grit",
    "./biome-plugins/d04-no-protected.grit",
    "./biome-plugins/i04-for-of.grit",
    "./biome-plugins/r01-export-class.grit",
    "./biome-plugins/r06-r08-accessibility.grit",
    "./biome-plugins/r15-no-module-let.grit",
    "./biome-plugins/r20-acronym-case.grit"
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDuplicateProperties": "off"
      },
      "a11y": {
        "useHeadingContent": "off"
      },
      "style": {
        "noParameterProperties": "error",
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": false }, ":BLANK_LINE:", { "type": true }]
          }
        }
      }
    }
  }
}
